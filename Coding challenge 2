function isValidJsBasicsIdentifier(value) {
  const reservedWords = new Set([
    "let",
    "const",
    "var",
    "class",
    "function",
    "return"
  ]);

  if (typeof value !== "string") {
    return false;
  }

  const trimmed = value.trim();

  if (trimmed.length === 0) {
    return false;
  }

  if (reservedWords.has(trimmed)) {
    return false;
  }

  return /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(trimmed);
}
